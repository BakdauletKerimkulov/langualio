{
  "$comment": [
    "Раскатывается из agentic-coding-toolkit/templates/claude/settings.json.",
    "Правки — в базе. settings.local.json остаётся личным и не синкается.",
    "deny здесь — второй рубеж; основной enforcement в hooks/, потому что",
    "он умеет смотреть на состояние (.gate/approved_sha), а не только на путь."
  ],
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/serviceAccount*.json)",
      "Edit(./.gate/**)",
      "Edit(./scripts/gate.sh)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.github/workflows/**)",
      "Edit(./ai_toolkit/**)",
      "Bash(git push*--force*)",
      "Bash(git reset*--hard*)",
      "Bash(firebase deploy:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)"
    ],
    "ask": [
      "Edit(./firestore.rules)",
      "Edit(./storage.rules)",
      "Edit(./supabase/migrations/**)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)"
    ],
    "allow": [
      "Bash(./scripts/gate.sh:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get)",
      "Bash(dart format:*)",
      "Bash(dart run build_runner:*)",
      "Bash(dart run custom_lint)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-edits.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
